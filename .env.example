# Neon Postgres (set automatically by the Vercel Neon integration)
DATABASE_URL=

# Clerk (set automatically by the Vercel Clerk integration)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Vercel Blob, private store for receipt photos (set when the store is connected)
BLOB_READ_WRITE_TOKEN=

# Receipt reading. On Vercel, AI Gateway authenticates with the project's OIDC
# token and none of these are needed. Locally, set one of the first two.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# Optional: a different model than Claude Opus 5.5
RECEIPT_VISION_MODEL=

# Vercel Cron: Vercel sends this as a bearer token to /api/cron/* (the daily
# cleanup of receipt photos that were never saved). Any random string of 16+
# characters; without it the cron routes refuse every call.
CRON_SECRET=

# Optional. Comma-separated Clerk OAuth client ids allowed to use the MCP
# server (/api/mcp). Unset, any OAuth client of the Clerk instance is accepted,
# which Claude, ChatGPT and Gemini need: they register themselves dynamically.
# Tokens issued for another resource (their `aud`) are refused either way.
# MCP_OAUTH_CLIENT_IDS=

# Optional. Public origin used for canonical links, robots.txt and the sitemap.
# Defaults to Vercel's production domain, then https://budget.patmac.ca.
# NEXT_PUBLIC_SITE_URL=https://budget.patmac.ca
