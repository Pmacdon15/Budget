# Neon Postgres (set automatically by the Vercel Neon integration)
DATABASE_URL=

# Clerk (set automatically by the Vercel Clerk integration)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Vercel Blob, private store for receipt photos (set when the store is connected)
BLOB_READ_WRITE_TOKEN=

# Receipt reading. On Vercel, AI Gateway authenticates with the project's OIDC
# token and none of these are needed. Locally, set one of the first two.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# Optional: a different model than Claude Haiku 5.5
RECEIPT_VISION_MODEL=
